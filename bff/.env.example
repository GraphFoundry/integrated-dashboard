# FitSMS credentials (optional — for SMS alerting)
FITSMS_API_KEY=
FITSMS_SENDER_ID=
SMS_RECIPIENT=

# OpenAI API key (optional — for SMS alert summarization)
OPENAI_API_KEY=

PORT=3001

# Shared webhook secret for graph updates from analysis-engine (REQUIRED)
WEBHOOK_SECRET=change-me-to-a-real-secret
WEBHOOK_REPLAY_WINDOW_SEC=300
WEBHOOK_DEDUPE_WINDOW_SEC=86400
WEBHOOK_DEDUPE_FILE=./data/webhook-dedupe.json
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120

# Graph engine health endpoint
GRAPH_HEALTH_URL=http://localhost:3000/graph/health
