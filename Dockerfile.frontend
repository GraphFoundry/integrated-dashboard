# ─── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies first (layer cache)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source
COPY index.html           ./
COPY tsconfig.json         ./
COPY tsconfig.node.json    ./
COPY vite.config.ts        ./
COPY tailwind.config.ts    ./
COPY eslint.config.js      ./
COPY src/                  ./src/

# ── Vite build-time variables (VITE_* are baked into the JS bundle) ──────────
# In production Docker, VITE_BFF_URL must be empty so that fetch("/api/...")
# goes to the same origin and nginx proxies it to the BFF container.
ARG VITE_BFF_URL=""
ARG VITE_PREDICTIVE_API_BASE_URL="http://localhost:7000"
ARG VITE_SCHEDULER_API_BASE_URL="http://localhost:9020"
ARG VITE_GRAPH_ALERT_API_BASE_URL=""
ARG VITE_ENABLE_GRAPH_DIRECT_FALLBACK="false"
ARG VITE_GRAPH_CACHE_REFRESH_MS="5000"
ARG VITE_ALLOW_DEMO_CONSTRAINT_OVERRIDE="false"

ENV VITE_BFF_URL=$VITE_BFF_URL
ENV VITE_PREDICTIVE_API_BASE_URL=$VITE_PREDICTIVE_API_BASE_URL
ENV VITE_SCHEDULER_API_BASE_URL=$VITE_SCHEDULER_API_BASE_URL
ENV VITE_GRAPH_ALERT_API_BASE_URL=$VITE_GRAPH_ALERT_API_BASE_URL
ENV VITE_ENABLE_GRAPH_DIRECT_FALLBACK=$VITE_ENABLE_GRAPH_DIRECT_FALLBACK
ENV VITE_GRAPH_CACHE_REFRESH_MS=$VITE_GRAPH_CACHE_REFRESH_MS
ENV VITE_ALLOW_DEMO_CONSTRAINT_OVERRIDE=$VITE_ALLOW_DEMO_CONSTRAINT_OVERRIDE

RUN npm run build

# ─── Stage 2: Serve with nginx ───────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Remove default nginx site
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom nginx config
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

# nginx runs as non-root (nginx user) by default in the official image.
# The config below uses "user nginx;" to make this explicit.

CMD ["nginx", "-g", "daemon off;"]
