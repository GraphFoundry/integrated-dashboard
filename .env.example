# Dev server configuration
VITE_DEV_SERVER_PORT=5173

# Predictive Analysis Engine base URL
VITE_PREDICTIVE_API_BASE_URL=http://localhost:7000

# Kubernetes Scheduler Extender API base URL
VITE_SCHEDULER_API_BASE_URL=http://localhost:9020

# Graph Dependency Alert Engine base URL (BFF)
VITE_BFF_URL=http://localhost:3001

# Graph Dependency Alert Engine base URL (PRODUCTION ONLY)
# Placeholder port - set the actual port when the service is available
VITE_GRAPH_ALERT_API_BASE_URL=http://localhost:PORT

# Optional fallback for graph stream startup:
# false (recommended) -> rely on BFF cache + WebSocket only
# true                -> allows direct analysis-engine snapshot fallback
VITE_ENABLE_GRAPH_DIRECT_FALLBACK=false

# Optional BFF cache refresh interval (ms) used as a resilience layer
# for graph pages alongside WebSocket updates.
VITE_GRAPH_CACHE_REFRESH_MS=5000
