# ==============================================================================
#  Integrated Dashboard — Environment Variables
# ==============================================================================
#  Copy this file to .env and fill in real values.
#  • VITE_*  variables are BUILD-TIME: baked into the JS bundle by Vite.
#  • All others are RUNTIME: read by the BFF container at startup.
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
#  1. VITE BUILD-TIME VARIABLES  (used by `npm run build` / Dockerfile.frontend)
# ──────────────────────────────────────────────────────────────────────────────

# Dev server port (local dev only; ignored in Docker)
VITE_DEV_SERVER_PORT=5173

# Predictive Analysis Engine base URL
VITE_PREDICTIVE_API_BASE_URL=http://localhost:7000

# Kubernetes Scheduler Extender API base URL
VITE_SCHEDULER_API_BASE_URL=http://localhost:9020

# BFF base URL — leave EMPTY for Docker (nginx proxies /api/* to BFF).
# For local dev, set to http://localhost:3001
VITE_BFF_URL=http://localhost:3001

# Graph Alert API base URL (production only)
VITE_GRAPH_ALERT_API_BASE_URL=

# Enable direct analysis-engine graph fallback (false recommended)
VITE_ENABLE_GRAPH_DIRECT_FALLBACK=false

# BFF cache refresh interval in ms (resilience layer alongside WebSocket)
VITE_GRAPH_CACHE_REFRESH_MS=5000

# Allow editing demo constraint overrides (dev only, ignored in production)
VITE_ALLOW_DEMO_CONSTRAINT_OVERRIDE=false


# ──────────────────────────────────────────────────────────────────────────────
#  2. BFF RUNTIME VARIABLES  (read by the BFF Node.js process at startup)
# ──────────────────────────────────────────────────────────────────────────────

# BFF listen port (internal; mapped by docker-compose)
PORT=3001

# Path to SQLite/in-memory DB (currently in-memory; reserved for future use)
DB_PATH=./alerts.db

# Shared webhook secret for graph updates from analysis-engine (REQUIRED)
WEBHOOK_SECRET=change-me-to-a-real-secret

# Webhook replay protection window in seconds
WEBHOOK_REPLAY_WINDOW_SEC=300

# Webhook deduplication window in seconds
WEBHOOK_DEDUPE_WINDOW_SEC=86400

# Webhook dedupe file path (inside the container, persisted via named volume)
WEBHOOK_DEDUPE_FILE=/app/data/webhook-dedupe.json

# Webhook rate-limit: max requests per window
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120

# Graph engine health endpoint used by BFF to check staleness
GRAPH_HEALTH_URL=http://localhost:3000/graph/health

# FitSMS API credentials (optional — for SMS alerting)
FITSMS_API_KEY=
FITSMS_SENDER_ID=
SMS_RECIPIENT=

# OpenAI API key (optional — for SMS alert summarization)
OPENAI_API_KEY=


# ──────────────────────────────────────────────────────────────────────────────
#  3. DOCKER-COMPOSE CONVENIENCE  (override host-side port mappings)
# ──────────────────────────────────────────────────────────────────────────────

# Host port for the frontend (nginx)
FRONTEND_PORT=8080

# Host port for the BFF (direct access, useful for debugging)
BFF_PORT=3001
